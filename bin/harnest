#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks to find the real script location (works with Homebrew symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

# Homebrew layout: share/harnest/nest/...  Local dev: nest/...
if [ -d "$SCRIPT_DIR/../share/harnest/nest" ]; then
  SHARE_DIR="$SCRIPT_DIR/../share/harnest"
elif [ -d "$SCRIPT_DIR/../nest" ]; then
  SHARE_DIR="$SCRIPT_DIR/.."
else
  SHARE_DIR="$SCRIPT_DIR/.."
fi

# Resolve lib directory (Homebrew or local dev)
if [ -d "$SCRIPT_DIR/../share/harnest/lib" ]; then
  LIB_DIR="$SCRIPT_DIR/../share/harnest/lib"
else
  LIB_DIR="$SCRIPT_DIR/../lib"
fi

# ── Nest mode detection ─────────────────────────────────────────────────────
# Prefer filesystem nest/ dir (local dev). Fall back to embedded registry (Homebrew).
NEST_DIR="$SHARE_DIR/nest"
REGISTRY_FILE="$LIB_DIR/nest-registry.json"

if [ -d "$NEST_DIR" ]; then
  NEST_MODE="dir"
elif [ -f "$REGISTRY_FILE" ]; then
  NEST_MODE="registry"
else
  NEST_MODE="none"
fi

VERSION_FILE="$SCRIPT_DIR/../VERSION"

# Global config
HARNEST_CONFIG_DIR="$HOME/.config/harnest"
HARNEST_CONFIG="$HARNEST_CONFIG_DIR/config"

# Read version from VERSION file, fallback to "dev"
if [ -f "$VERSION_FILE" ]; then
  VERSION="$(cat "$VERSION_FILE")"
else
  # Homebrew installs may not have VERSION at prefix root; try share dir
  VERSION="dev"
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
harnest $VERSION — Composable Claude Code agent team harness

Usage:
  harnest hatch [--chick <name>] [--force]   Scaffold a nest into the current project
  harnest nest                               List available chicks
  harnest nest show <name>                   Show chick details (agents, files)
  harnest nest export <name> [--dir <path>]  Export chick files to a directory
  harnest flock [run] [--file <path>]        Run a flock pipeline (interactive)
  harnest flock --auto [--file <path>]       Run a flock pipeline autonomously
  harnest flock validate [--file <path>]     Validate a flock.yaml file
  harnest flock init                         Generate a flock.yaml interactively
  harnest flock clean                        Remove temp flock agent files
  harnest --chick <name>                     Set the global default chick
  harnest help                               Show this help message
  harnest version                            Print version

Options:
  --chick <name>   Chick (nest template) to use (default: fullstack)
  --force          Overwrite existing files during hatch
  --file <path>    Path to flock.yaml (default: ./flock.yaml)
EOF
}

info()  { printf '  \033[32m✓\033[0m %s\n' "$1"; }
skip()  { printf '  \033[33m⊘\033[0m %s (already exists, use --force to overwrite)\n' "$1"; }
warn()  { printf '  \033[33m!\033[0m %s\n' "$1"; }
merge() { printf '  \033[36m⇄\033[0m %s\n' "$1"; }

# ── Registry helpers ─────────────────────────────────────────────────────────
# These functions read from lib/nest-registry.json when the nest/ dir is absent.

registry_list_chicks() {
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
for name in sorted(reg['chicks']):
    print(name)
" "$REGISTRY_FILE"
}

registry_chick_exists() {
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
sys.exit(0 if sys.argv[2] in reg['chicks'] else 1)
" "$REGISTRY_FILE" "$1"
}

registry_chick_description() {
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
chick = reg['chicks'].get(sys.argv[2], {})
print(chick.get('description', ''))
" "$REGISTRY_FILE" "$1"
}

registry_chick_agents() {
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
chick = reg['chicks'].get(sys.argv[2], {})
for a in chick.get('agents', []):
    print(a)
" "$REGISTRY_FILE" "$1"
}

registry_list_files() {
  local chick_name="$1"
  local prefix="${2:-}"
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
chick = reg['chicks'].get(sys.argv[2], {})
prefix = sys.argv[3] if len(sys.argv) > 3 else ''
for path in sorted(chick.get('files', {})):
    if not prefix or path.startswith(prefix):
        print(path)
" "$REGISTRY_FILE" "$chick_name" "$prefix"
}

registry_extract_file() {
  local chick_name="$1" rel_path="$2"
  python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
chick = reg['chicks'].get(sys.argv[2], {})
content = chick.get('files', {}).get(sys.argv[3])
if content is None:
    sys.exit(1)
sys.stdout.write(content)
" "$REGISTRY_FILE" "$chick_name" "$rel_path"
}

# Export an entire chick from the registry to a temp directory.
# Returns the temp dir path via stdout. Caller should clean up.
registry_export_chick() {
  local chick_name="$1"
  local dest_dir="${2:-}"
  if [ -z "$dest_dir" ]; then
    dest_dir="$(mktemp -d "${TMPDIR:-/tmp}/harnest-${chick_name}-XXXXXX")"
  fi
  python3 -c "
import json, os, sys
with open(sys.argv[1]) as f:
    reg = json.load(f)
chick = reg['chicks'].get(sys.argv[2])
if not chick:
    print(f'Error: chick \"{sys.argv[2]}\" not found in registry', file=sys.stderr)
    sys.exit(1)
dest = sys.argv[3]
for rel_path, content in chick.get('files', {}).items():
    full_path = os.path.join(dest, rel_path)
    os.makedirs(os.path.dirname(full_path), exist_ok=True)
    with open(full_path, 'w') as f:
        f.write(content)
" "$REGISTRY_FILE" "$chick_name" "$dest_dir"
  echo "$dest_dir"
}

# Ensure a chick exists in either filesystem or registry
check_chick_exists() {
  local name="$1"
  if [ "$NEST_MODE" = "dir" ]; then
    [ -d "$NEST_DIR/$name" ]
  elif [ "$NEST_MODE" = "registry" ]; then
    registry_chick_exists "$name"
  else
    return 1
  fi
}

get_default_chick() {
  if [ -f "$HARNEST_CONFIG" ]; then
    local chick
    chick="$(grep '^chick=' "$HARNEST_CONFIG" 2>/dev/null | cut -d= -f2)"
    if [ -n "$chick" ]; then
      echo "$chick"
      return
    fi
  fi
  echo "fullstack"
}

set_default_chick() {
  local name="$1"
  if ! check_chick_exists "$name"; then
    echo "Error: Chick '$name' not found." >&2
    cmd_nest >&2
    exit 1
  fi
  mkdir -p "$HARNEST_CONFIG_DIR"
  echo "chick=$name" > "$HARNEST_CONFIG"
  info "Default chick set to '$name' (saved to $HARNEST_CONFIG)"
}

resolve_chick_dir() {
  local name="$1"
  if [ "$NEST_MODE" = "dir" ]; then
    local chick_dir="$NEST_DIR/$name"
    if [ ! -d "$chick_dir" ]; then
      echo "Error: Chick '$name' not found." >&2
      cmd_nest >&2
      exit 1
    fi
    echo "$chick_dir"
  elif [ "$NEST_MODE" = "registry" ]; then
    if ! registry_chick_exists "$name"; then
      echo "Error: Chick '$name' not found." >&2
      cmd_nest >&2
      exit 1
    fi
    # Export chick from registry to a temp dir (cleaned up on exit)
    local tmp_dir
    tmp_dir="$(registry_export_chick "$name")"
    _HARNEST_TMPDIR_CLEANUP+=("$tmp_dir")
    echo "$tmp_dir"
  else
    echo "Error: No nest directory or registry found. Is harnest installed correctly?" >&2
    exit 1
  fi
}

# Track temp dirs for cleanup
_HARNEST_TMPDIR_CLEANUP=()
_harnest_cleanup() {
  if [ "${#_HARNEST_TMPDIR_CLEANUP[@]}" -gt 0 ]; then
    for d in "${_HARNEST_TMPDIR_CLEANUP[@]}"; do
      [ -d "$d" ] && rm -rf "$d"
    done
  fi
}
trap _harnest_cleanup EXIT

# Copy a file from chick dir to a destination, respecting --force
copy_file() {
  local src="$1" dst="$2" force="$3"
  if [ -f "$dst" ] && [ "$force" != "true" ]; then
    skip "$dst"
    return 1
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
  info "$dst"
  return 0
}

# ── CLAUDE.md handling ───────────────────────────────────────────────────────

MARKER_BEGIN="<!-- harnest:begin -->"
MARKER_END="<!-- harnest:end -->"

claudemd_section() {
  local chick_dir="$1"
  # Extract content from chick CLAUDE.md wrapped in markers
  printf '%s\n' "$MARKER_BEGIN"
  cat "$chick_dir/CLAUDE.md"
  printf '\n%s\n' "$MARKER_END"
}

handle_claudemd() {
  local chick_dir="$1" force="$2"
  if [ ! -f "CLAUDE.md" ]; then
    # No existing CLAUDE.md — write chick with markers
    claudemd_section "$chick_dir" > "CLAUDE.md"
    info "CLAUDE.md (created)"
  elif [ "$force" = "true" ]; then
    # Force mode — replace harnest section or create fresh
    if grep -q "$MARKER_BEGIN" "CLAUDE.md" 2>/dev/null; then
      replace_claudemd_section "$chick_dir"
      info "CLAUDE.md (harnest section replaced)"
    else
      printf '\n' >> "CLAUDE.md"
      claudemd_section "$chick_dir" >> "CLAUDE.md"
      info "CLAUDE.md (harnest section appended)"
    fi
  elif grep -q "$MARKER_BEGIN" "CLAUDE.md" 2>/dev/null; then
    # Already has harnest section
    skip "CLAUDE.md (harnest section)"
  else
    # Exists but no harnest section — append
    printf '\n' >> "CLAUDE.md"
    claudemd_section "$chick_dir" >> "CLAUDE.md"
    info "CLAUDE.md (harnest section appended)"
  fi
}

replace_claudemd_section() {
  local chick_dir="$1"
  local tmp
  tmp="$(mktemp)"
  local in_section=false
  local replaced=false
  while IFS= read -r line; do
    if [ "$line" = "$MARKER_BEGIN" ]; then
      in_section=true
      if [ "$replaced" = "false" ]; then
        claudemd_section "$chick_dir" >> "$tmp"
        replaced=true
      fi
      continue
    fi
    if [ "$line" = "$MARKER_END" ]; then
      in_section=false
      continue
    fi
    if [ "$in_section" = "false" ]; then
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "CLAUDE.md"
  mv "$tmp" "CLAUDE.md"
}

# ── settings.json deep merge ────────────────────────────────────────────────

merge_settings() {
  local src="$1" dst="$2" force="$3"
  if [ ! -f "$dst" ]; then
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    info "$dst (created)"
    return
  fi
  if [ "$force" = "true" ]; then
    cp "$src" "$dst"
    info "$dst (overwritten)"
    return
  fi
  # Deep merge using python3 (ships on macOS)
  local tmp
  tmp="$(mktemp)"
  python3 -c "
import json, sys

def deep_merge(base, overlay):
    for key, val in overlay.items():
        if key in base and isinstance(base[key], dict) and isinstance(val, dict):
            deep_merge(base[key], val)
        elif key in base and isinstance(base[key], list) and isinstance(val, list):
            # Union lists (preserve order, no duplicates)
            seen = set(json.dumps(x, sort_keys=True) if isinstance(x, (dict, list)) else x for x in base[key])
            for item in val:
                k = json.dumps(item, sort_keys=True) if isinstance(item, (dict, list)) else item
                if k not in seen:
                    base[key].append(item)
                    seen.add(k)
        else:
            base[key] = val
    return base

with open(sys.argv[1]) as f:
    existing = json.load(f)
with open(sys.argv[2]) as f:
    chick = json.load(f)

merged = deep_merge(existing, chick)
print(json.dumps(merged, indent=2))
" "$dst" "$src" > "$tmp" && mv "$tmp" "$dst"
  merge "Merged $dst"
}

# ── Nest command ─────────────────────────────────────────────────────────────

cmd_nest() {
  local subcmd="${1:-list}"
  case "$subcmd" in
    list)  _nest_list ;;
    show)  shift; _nest_show "$@" ;;
    export) shift; _nest_export "$@" ;;
    *)     _nest_list ;;
  esac
}

_nest_list() {
  local default_chick
  default_chick="$(get_default_chick)"
  echo "Available chicks:"

  if [ "$NEST_MODE" = "dir" ]; then
    for dir in "$NEST_DIR"/*/; do
      [ -d "$dir" ] || continue
      local name
      name="$(basename "$dir")"
      if [ "$name" = "$default_chick" ]; then
        echo "  $name (default)"
      else
        echo "  $name"
      fi
    done
  elif [ "$NEST_MODE" = "registry" ]; then
    while IFS= read -r name; do
      if [ "$name" = "$default_chick" ]; then
        echo "  $name (default)"
      else
        echo "  $name"
      fi
    done < <(registry_list_chicks)
  else
    echo "Error: No nest directory or registry found." >&2
    echo "Is harnest installed correctly?" >&2
    exit 1
  fi
}

_nest_show() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "Usage: harnest nest show <chick>" >&2
    exit 1
  fi
  if ! check_chick_exists "$name"; then
    echo "Error: Chick '$name' not found." >&2
    exit 1
  fi

  echo "Chick: $name"
  echo ""

  if [ "$NEST_MODE" = "registry" ]; then
    local desc
    desc="$(registry_chick_description "$name")"
    if [ -n "$desc" ]; then
      echo "Description: $desc"
      echo ""
    fi
    echo "Agents:"
    registry_chick_agents "$name" | while IFS= read -r agent; do
      echo "  - $agent"
    done
    echo ""
    echo "Files:"
    registry_list_files "$name" | while IFS= read -r fpath; do
      echo "  $fpath"
    done
  else
    local chick_dir="$NEST_DIR/$name"
    if [ -f "$chick_dir/README.md" ]; then
      head -5 "$chick_dir/README.md"
      echo ""
    fi
    echo "Agents:"
    for agent in "$chick_dir"/claude/agents/*.md; do
      [ -f "$agent" ] || continue
      echo "  - $(basename "$agent" .md)"
    done
    echo ""
    echo "Files:"
    (cd "$chick_dir" && find . -type f | sort | sed 's|^\./|  |')
  fi
}

_nest_export() {
  local name="" dest_dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir)
        if [ $# -lt 2 ]; then echo "Error: --dir requires a value"; exit 1; fi
        dest_dir="$2"; shift 2 ;;
      *) name="$1"; shift ;;
    esac
  done

  if [ -z "$name" ]; then
    echo "Usage: harnest nest export <chick> [--dir <path>]" >&2
    exit 1
  fi
  if ! check_chick_exists "$name"; then
    echo "Error: Chick '$name' not found." >&2
    exit 1
  fi

  if [ -z "$dest_dir" ]; then
    dest_dir="./$name"
  fi

  echo "Exporting chick '$name' to $dest_dir..."
  echo ""

  if [ "$NEST_MODE" = "registry" ]; then
    registry_export_chick "$name" "$dest_dir" > /dev/null
  else
    mkdir -p "$dest_dir"
    cp -R "$NEST_DIR/$name/" "$dest_dir/"
  fi

  info "exported to $dest_dir"
}

# ── Hatch command ─────────────────────────────────────────────────────────────

cmd_hatch() {
  local force=false
  local chick=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=true; shift ;;
      --chick)
        if [ $# -lt 2 ]; then
          echo "Error: --chick requires a value"
          exit 1
        fi
        chick="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  # Resolve chick name
  if [ -z "$chick" ]; then
    chick="$(get_default_chick)"
  fi

  local chick_dir
  chick_dir="$(resolve_chick_dir "$chick")"

  echo "Hatching harnest ($chick chick) in $(pwd)..."
  echo ""

  # 1. harnest.yaml
  copy_file "$chick_dir/harnest.yaml" "./harnest.yaml" "$force" || true

  # 2. CLAUDE.md
  handle_claudemd "$chick_dir" "$force"

  # 3. Agent definitions
  mkdir -p ".claude/agents"
  for agent in "$chick_dir"/claude/agents/*.md; do
    [ -f "$agent" ] || continue
    local agent_name
    agent_name="$(basename "$agent")"
    copy_file "$agent" ".claude/agents/$agent_name" "$force" || true
  done

  # 4. settings.local.json.example
  if [ -f "$chick_dir/claude/settings.local.json.example" ]; then
    copy_file "$chick_dir/claude/settings.local.json.example" ".claude/settings.local.json.example" "$force" || true
  fi

  # 5. settings.json (deep merge)
  if [ -f "$chick_dir/claude/settings.json" ]; then
    merge_settings "$chick_dir/claude/settings.json" ".claude/settings.json" "$force"
  fi

  # 6. mcp.json.example — copy if present; add .mcp.json to .gitignore
  if [ -f "$chick_dir/claude/mcp.json.example" ]; then
    copy_file "$chick_dir/claude/mcp.json.example" ".mcp.json.example" "$force" || true
    if [ -f ".gitignore" ]; then
      if ! grep -qxF '.mcp.json' .gitignore; then
        echo '.mcp.json' >> .gitignore
        info "added .mcp.json to .gitignore"
      fi
    else
      echo '.mcp.json' > .gitignore
      info "created .gitignore with .mcp.json"
    fi
  fi

  echo ""
  echo "Done! Next steps:"
  echo "  1. Customize harnest.yaml (optional)"
  if [ -f ".mcp.json.example" ]; then
    echo "  2. Set up Nano Banana MCP for AI image generation:"
    echo "     cp .mcp.json.example .mcp.json   # credentials via shell env vars — see .mcp.json.example"
    echo "  3. Run 'claude' to start a harnest session"
  else
    echo "  2. Run 'claude' to start a harnest session"
  fi
}

# ── Flock commands ───────────────────────────────────────────────────────────

flock_usage() {
  cat <<EOF
harnest flock — Chain multiple chicks into a pipeline

Usage:
  harnest flock [run] [--file <path>]     Run a flock pipeline (interactive)
  harnest flock --auto [--file <path>]    Run a flock pipeline autonomously
  harnest flock validate [--file <path>]  Validate a flock.yaml file
  harnest flock init                      Generate a flock.yaml interactively
  harnest flock clean                     Remove temp flock agent files

Options:
  --file <path>   Path to flock.yaml (default: ./flock.yaml)
EOF
}

cmd_flock_validate() {
  local flock_file="flock.yaml"
  local extra_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)
        if [ $# -lt 2 ]; then echo "Error: --file requires a value"; exit 1; fi
        flock_file="$2"; shift 2 ;;
      --parse) extra_args+=("--parse"); shift ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  if [ ! -f "$flock_file" ]; then
    echo "Error: $flock_file not found" >&2
    exit 1
  fi
  if [ ! -f "$LIB_DIR/validate-flock.py" ]; then
    echo "Error: validator not found at $LIB_DIR/validate-flock.py" >&2
    echo "Is harnest installed correctly?" >&2
    exit 1
  fi

  if [ "$NEST_MODE" = "registry" ]; then
    python3 "$LIB_DIR/validate-flock.py" "$flock_file" --registry "$REGISTRY_FILE" "${extra_args[@]}"
  else
    python3 "$LIB_DIR/validate-flock.py" "$flock_file" "$NEST_DIR" "${extra_args[@]}"
  fi
}

cmd_flock_init() {
  local chick="flock"
  local chick_dir
  chick_dir="$(resolve_chick_dir "$chick")"

  echo "Hatching flock meta-chick to help you create a flock.yaml..."
  echo ""

  # Hatch the flock chick into the current project
  cmd_hatch --chick flock "$@"
}

# Shared setup: validate, hatch agents, generate conductor. Does NOT launch claude.
# Sets FLOCK_SETUP_OK=1 on success.
_flock_setup() {
  local flock_file="$1"
  FLOCK_SETUP_OK=0

  # Validate
  echo "Preflight check..."
  echo ""
  if ! cmd_flock_validate --file "$flock_file"; then
    echo ""
    echo "Fix the errors above before running the flock." >&2
    return 1
  fi
  echo ""

  # Read chick references from flock.yaml and hatch agents
  mkdir -p ".claude/agents"
  mkdir -p ".flock"

  # Extract chick aliases and their nest chick names using the validator's --parse mode
  local chick_map
  chick_map="$(cmd_flock_validate --file "$flock_file" --parse | python3 -c "
import sys, json
data = json.load(sys.stdin)
chicks = data.get('chicks', {})
for alias, cfg in chicks.items():
    if isinstance(cfg, dict) and 'chick' in cfg:
        print(f'{alias}={cfg[\"chick\"]}')
")"

  if [ -z "$chick_map" ]; then
    echo "Error: could not parse chick mappings from $flock_file" >&2
    return 1
  fi

  echo "Preparing flock agents..."
  echo ""

  # Hatch namespaced agents from each referenced chick.
  # resolve_chick_dir handles both filesystem and registry modes.
  while IFS='=' read -r alias chick_name; do
    local src_dir
    src_dir="$(resolve_chick_dir "$chick_name")"

    if [ ! -d "$src_dir/claude/agents" ]; then
      warn "chick '$chick_name' has no agents directory"
      continue
    fi
    for agent_file in "$src_dir"/claude/agents/*.md; do
      [ -f "$agent_file" ] || continue
      local agent_basename
      agent_basename="$(basename "$agent_file")"
      local namespaced="flock-${alias}-${agent_basename}"
      cp "$agent_file" ".claude/agents/$namespaced"
      info "hatched agent: $namespaced"
    done

    # Merge settings from each chick
    if [ -f "$src_dir/claude/settings.json" ]; then
      merge_settings "$src_dir/claude/settings.json" ".claude/settings.json" "false"
    fi
  done <<< "$chick_map"

  # Generate the conductor agent from template
  if [ -f "$LIB_DIR/flock-conductor-template.md" ]; then
    local conductor_file=".claude/agents/flock-conductor.md"
    local flock_contents
    flock_contents="$(cat "$flock_file")"

    # Copy conductor template
    cp "$LIB_DIR/flock-conductor-template.md" "$conductor_file"

    # Append the flock.yaml contents as context
    printf '\n## Flock Configuration (flock.yaml)\n\n```yaml\n%s\n```\n' "$flock_contents" >> "$conductor_file"

    # Append the agent mapping
    printf '%s\n\n' '## Agent Mapping' >> "$conductor_file"
    while IFS='=' read -r alias chick_name; do
      local src_dir
      src_dir="$(resolve_chick_dir "$chick_name")"
      printf -- '- **%s** (%s): ' "$alias" "$chick_name" >> "$conductor_file"
      for agent_file in "$src_dir"/claude/agents/*.md; do
        [ -f "$agent_file" ] || continue
        local agent_basename
        agent_basename="$(basename "$agent_file")"
        printf -- '`flock-%s-%s` ' "$alias" "$agent_basename" >> "$conductor_file"
      done
      printf '\n' >> "$conductor_file"
    done <<< "$chick_map"

    info "generated conductor agent: $conductor_file"
  else
    echo "Error: conductor template not found at $LIB_DIR/flock-conductor-template.md" >&2
    return 1
  fi

  # Copy flock.yaml to project root if not already there
  if [ "$(realpath "$flock_file" 2>/dev/null)" != "$(realpath ./flock.yaml 2>/dev/null)" ]; then
    cp "$flock_file" "./flock.yaml"
    info "copied flock.yaml to project root"
  fi

  # Clean up flock-init artifacts so Claude doesn't re-enter the pipeline-creation
  # loop. The flock chick hatches interviewer.md and composer.md plus a CLAUDE.md
  # that instructs Claude to create a flock.yaml. Once flock.yaml exists these must
  # be replaced with the conductor workflow.
  for init_agent in interviewer.md composer.md; do
    if [ -f ".claude/agents/$init_agent" ]; then
      rm ".claude/agents/$init_agent"
      info "removed flock-init agent: $init_agent"
    fi
  done

  # Replace the harnest CLAUDE.md section with a flock-run directive that points
  # Claude at the conductor agent instead of the pipeline-creation workflow.
  if [ -f "CLAUDE.md" ] && grep -q "$MARKER_BEGIN" "CLAUDE.md" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    local in_section=false
    local replaced=false
    while IFS= read -r line; do
      if [ "$line" = "$MARKER_BEGIN" ]; then
        in_section=true
        if [ "$replaced" = "false" ]; then
          printf '%s\n' "$MARKER_BEGIN" >> "$tmp"
          cat >> "$tmp" <<'FLOCK_CLAUDEMD'
# Harnest — Flock Pipeline Run

A flock pipeline is ready. The `flock-conductor` agent has been generated with the full execution plan.

**Start the flock conductor agent immediately.** Do not create teams or spawn agents yourself — the conductor handles everything.

Read `flock.yaml` only if you need context, but defer all orchestration to the conductor.
FLOCK_CLAUDEMD
          printf '\n%s\n' "$MARKER_END" >> "$tmp"
          replaced=true
        fi
        continue
      fi
      if [ "$line" = "$MARKER_END" ]; then
        in_section=false
        continue
      fi
      if [ "$in_section" = "false" ]; then
        printf '%s\n' "$line" >> "$tmp"
      fi
    done < "CLAUDE.md"
    mv "$tmp" "CLAUDE.md"
    info "CLAUDE.md updated for flock run (replaced pipeline-creation workflow)"
  fi

  FLOCK_SETUP_OK=1
}

cmd_flock_run() {
  local flock_file="flock.yaml"
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)
        if [ $# -lt 2 ]; then echo "Error: --file requires a value"; exit 1; fi
        flock_file="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  _flock_setup "$flock_file" || exit 1

  echo ""
  echo "Launching flock conductor..."
  echo ""

  # Launch claude — the conductor agent takes over
  claude || true

  # Cleanup after claude session exits
  echo ""
  echo "Flock session ended. Cleaning up..."
  cmd_flock_clean
}

cmd_flock_auto() {
  local flock_file="flock.yaml"
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)
        if [ $# -lt 2 ]; then echo "Error: --file requires a value"; exit 1; fi
        flock_file="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  # Step 1: Validate
  echo "Preflight check..."
  echo ""
  if ! cmd_flock_validate --file "$flock_file"; then
    echo ""
    echo "Fix the errors above before running the flock." >&2
    exit 1
  fi
  echo ""

  # Step 2: Pre-flight interview — ask clarifying questions before autonomous execution
  echo "┌─────────────────────────────────────────────────────────────┐"
  echo "│  AUTONOMOUS MODE — Pre-flight Interview                     │"
  echo "│                                                             │"
  echo "│  Agents will run with elevated permissions.                 │"
  echo "│  Please answer the following questions carefully.           │"
  echo "└─────────────────────────────────────────────────────────────┘"
  echo ""

  # Extract and display execution plan for user review
  cmd_flock_validate --file "$flock_file" --parse | python3 -c "
import sys, json

data = json.load(sys.stdin)
chicks = data.get('chicks', {})
settings = data.get('settings', {})
timeout = settings.get('timeout', 30) if isinstance(settings, dict) else 30

print('Execution plan:')
print()
for i, (alias, cfg) in enumerate(chicks.items(), 1):
    if not isinstance(cfg, dict):
        continue
    chick = cfg.get('chick', '?')
    prompt = cfg.get('prompt', cfg.get('prompt_file', '(none)'))
    deps = cfg.get('depends_on', '(none)')
    t = cfg.get('timeout', timeout)
    print(f'  {i}. [{alias}] ({chick})')
    p = str(prompt)
    print(f'     Prompt: {p[:80]}...' if len(p) > 80 else f'     Prompt: {p}')
    print(f'     Depends on: {deps}')
    print(f'     Timeout: {t} min')
    print()

print(f'Global continue_on_failure: {settings.get(\"continue_on_failure\", False)}')
print(f'Global timeout: {timeout} min')
"
  echo ""

  # Ask for confirmation
  printf "Do you approve this execution plan? [y/N] "
  read -r confirm
  if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "Aborted."
    exit 0
  fi
  echo ""

  # Step 3: Set up the flock
  _flock_setup "$flock_file" || exit 1

  mkdir -p ".flock/logs"

  echo ""
  echo "Launching flock conductor in autonomous mode..."
  echo ""

  # Step 4: Launch claude autonomously with bypassed permissions
  claude --dangerously-skip-permissions || true

  # Step 5: Cleanup after claude session exits
  echo ""
  echo "Flock auto session ended. Cleaning up..."
  cmd_flock_clean
}

cmd_flock_clean() {
  echo "Cleaning up flock temp files..."
  echo ""

  # Remove namespaced flock agent files
  local count=0
  for f in .claude/agents/flock-*.md; do
    [ -f "$f" ] || continue
    rm "$f"
    info "removed $f"
    count=$((count + 1))
  done

  # Remove .flock/ working directory
  if [ -d ".flock" ]; then
    rm -rf ".flock"
    info "removed .flock/"
    count=$((count + 1))
  fi

  if [ "$count" -eq 0 ]; then
    echo "  Nothing to clean up."
  fi
  echo ""
  echo "Done. flock.yaml and chick outputs (e.g., brainstorm-output.md) are preserved."
}

cmd_flock() {
  case "${1:-run}" in
    run)       shift; cmd_flock_run "$@" ;;
    --auto)    shift; cmd_flock_auto "$@" ;;
    validate)  shift; cmd_flock_validate "$@" ;;
    init)      shift; cmd_flock_init "$@" ;;
    clean)     shift; cmd_flock_clean "$@" ;;
    help|--help|-h) flock_usage ;;
    *)         echo "Unknown flock command: $1"; flock_usage; exit 1 ;;
  esac
}

# ── Main ─────────────────────────────────────────────────────────────────────

case "${1:-help}" in
  hatch)      shift; cmd_hatch "$@" ;;
  nest)       shift; cmd_nest "$@" ;;
  flock)      shift; cmd_flock "$@" ;;
  --chick)
    if [ $# -lt 2 ]; then
      echo "Error: --chick requires a value"
      exit 1
    fi
    set_default_chick "$2" ;;
  version|--version|-v)  echo "harnest $VERSION" ;;
  help|--help|-h)        usage ;;
  *)          echo "Unknown command: $1"; usage; exit 1 ;;
esac
