#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks to find the real script location (works with Homebrew symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

# Homebrew layout: share/harnest/nest/...  Local dev: nest/...
if [ -d "$SCRIPT_DIR/../share/harnest/nest" ]; then
  SHARE_DIR="$SCRIPT_DIR/../share/harnest"
else
  SHARE_DIR="$SCRIPT_DIR/.."
fi
VERSION_FILE="$SCRIPT_DIR/../VERSION"

# Global config
HARNEST_CONFIG_DIR="$HOME/.config/harnest"
HARNEST_CONFIG="$HARNEST_CONFIG_DIR/config"

# Read version from VERSION file, fallback to "dev"
if [ -f "$VERSION_FILE" ]; then
  VERSION="$(cat "$VERSION_FILE")"
else
  # Homebrew installs may not have VERSION at prefix root; try share dir
  VERSION="dev"
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
harnest $VERSION — Composable Claude Code agent team harness

Usage:
  harnest hatch [--chick <name>] [--force]   Scaffold a nest into the current project
  harnest nest                               List available chicks
  harnest flock [run] [--file <path>]        Run a flock pipeline (interactive)
  harnest flock --auto [--file <path>]       Run a flock pipeline autonomously
  harnest flock validate [--file <path>]     Validate a flock.yaml file
  harnest flock init                         Generate a flock.yaml interactively
  harnest flock clean                        Remove temp flock agent files
  harnest --chick <name>                     Set the global default chick
  harnest help                               Show this help message
  harnest version                            Print version

Options:
  --chick <name>   Chick (nest template) to use (default: fullstack)
  --force          Overwrite existing files during hatch
  --file <path>    Path to flock.yaml (default: ./flock.yaml)
EOF
}

info()  { printf '  \033[32m✓\033[0m %s\n' "$1"; }
skip()  { printf '  \033[33m⊘\033[0m %s (already exists, use --force to overwrite)\n' "$1"; }
warn()  { printf '  \033[33m!\033[0m %s\n' "$1"; }
merge() { printf '  \033[36m⇄\033[0m %s\n' "$1"; }

get_default_chick() {
  if [ -f "$HARNEST_CONFIG" ]; then
    local chick
    chick="$(grep '^chick=' "$HARNEST_CONFIG" 2>/dev/null | cut -d= -f2)"
    if [ -n "$chick" ]; then
      echo "$chick"
      return
    fi
  fi
  echo "fullstack"
}

set_default_chick() {
  local name="$1"
  local chick_dir="$SHARE_DIR/nest/$name"
  if [ ! -d "$chick_dir" ]; then
    echo "Error: Chick '$name' not found." >&2
    cmd_nest >&2
    exit 1
  fi
  mkdir -p "$HARNEST_CONFIG_DIR"
  echo "chick=$name" > "$HARNEST_CONFIG"
  info "Default chick set to '$name' (saved to $HARNEST_CONFIG)"
}

resolve_chick_dir() {
  local name="$1"
  local chick_dir="$SHARE_DIR/nest/$name"
  if [ ! -d "$chick_dir" ]; then
    echo "Error: Chick '$name' not found." >&2
    cmd_nest >&2
    exit 1
  fi
  echo "$chick_dir"
}

# Copy a file from chick dir to a destination, respecting --force
copy_file() {
  local src="$1" dst="$2" force="$3"
  if [ -f "$dst" ] && [ "$force" != "true" ]; then
    skip "$dst"
    return 1
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
  info "$dst"
  return 0
}

# ── CLAUDE.md handling ───────────────────────────────────────────────────────

MARKER_BEGIN="<!-- harnest:begin -->"
MARKER_END="<!-- harnest:end -->"

claudemd_section() {
  local chick_dir="$1"
  # Extract content from chick CLAUDE.md wrapped in markers
  printf '%s\n' "$MARKER_BEGIN"
  cat "$chick_dir/CLAUDE.md"
  printf '\n%s\n' "$MARKER_END"
}

handle_claudemd() {
  local chick_dir="$1" force="$2"
  if [ ! -f "CLAUDE.md" ]; then
    # No existing CLAUDE.md — write chick with markers
    claudemd_section "$chick_dir" > "CLAUDE.md"
    info "CLAUDE.md (created)"
  elif [ "$force" = "true" ]; then
    # Force mode — replace harnest section or create fresh
    if grep -q "$MARKER_BEGIN" "CLAUDE.md" 2>/dev/null; then
      replace_claudemd_section "$chick_dir"
      info "CLAUDE.md (harnest section replaced)"
    else
      printf '\n' >> "CLAUDE.md"
      claudemd_section "$chick_dir" >> "CLAUDE.md"
      info "CLAUDE.md (harnest section appended)"
    fi
  elif grep -q "$MARKER_BEGIN" "CLAUDE.md" 2>/dev/null; then
    # Already has harnest section
    skip "CLAUDE.md (harnest section)"
  else
    # Exists but no harnest section — append
    printf '\n' >> "CLAUDE.md"
    claudemd_section "$chick_dir" >> "CLAUDE.md"
    info "CLAUDE.md (harnest section appended)"
  fi
}

replace_claudemd_section() {
  local chick_dir="$1"
  local tmp
  tmp="$(mktemp)"
  local in_section=false
  local replaced=false
  while IFS= read -r line; do
    if [ "$line" = "$MARKER_BEGIN" ]; then
      in_section=true
      if [ "$replaced" = "false" ]; then
        claudemd_section "$chick_dir" >> "$tmp"
        replaced=true
      fi
      continue
    fi
    if [ "$line" = "$MARKER_END" ]; then
      in_section=false
      continue
    fi
    if [ "$in_section" = "false" ]; then
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "CLAUDE.md"
  mv "$tmp" "CLAUDE.md"
}

# ── settings.json deep merge ────────────────────────────────────────────────

merge_settings() {
  local src="$1" dst="$2" force="$3"
  if [ ! -f "$dst" ]; then
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    info "$dst (created)"
    return
  fi
  if [ "$force" = "true" ]; then
    cp "$src" "$dst"
    info "$dst (overwritten)"
    return
  fi
  # Deep merge using python3 (ships on macOS)
  local tmp
  tmp="$(mktemp)"
  python3 -c "
import json, sys

def deep_merge(base, overlay):
    for key, val in overlay.items():
        if key in base and isinstance(base[key], dict) and isinstance(val, dict):
            deep_merge(base[key], val)
        elif key in base and isinstance(base[key], list) and isinstance(val, list):
            # Union lists (preserve order, no duplicates)
            seen = set(json.dumps(x, sort_keys=True) if isinstance(x, (dict, list)) else x for x in base[key])
            for item in val:
                k = json.dumps(item, sort_keys=True) if isinstance(item, (dict, list)) else item
                if k not in seen:
                    base[key].append(item)
                    seen.add(k)
        else:
            base[key] = val
    return base

with open(sys.argv[1]) as f:
    existing = json.load(f)
with open(sys.argv[2]) as f:
    chick = json.load(f)

merged = deep_merge(existing, chick)
print(json.dumps(merged, indent=2))
" "$dst" "$src" > "$tmp" && mv "$tmp" "$dst"
  merge "Merged $dst"
}

# ── Nest command ─────────────────────────────────────────────────────────────

cmd_nest() {
  local nest_dir="$SHARE_DIR/nest"
  if [ ! -d "$nest_dir" ]; then
    echo "Error: Nest directory not found at $nest_dir" >&2
    echo "Is harnest installed correctly?" >&2
    exit 1
  fi
  local default_chick
  default_chick="$(get_default_chick)"
  echo "Available chicks:"
  for dir in "$nest_dir"/*/; do
    [ -d "$dir" ] || continue
    local name
    name="$(basename "$dir")"
    if [ "$name" = "$default_chick" ]; then
      echo "  $name (default)"
    else
      echo "  $name"
    fi
  done
}

# ── Hatch command ─────────────────────────────────────────────────────────────

cmd_hatch() {
  local force=false
  local chick=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=true; shift ;;
      --chick)
        if [ $# -lt 2 ]; then
          echo "Error: --chick requires a value"
          exit 1
        fi
        chick="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  # Resolve chick name
  if [ -z "$chick" ]; then
    chick="$(get_default_chick)"
  fi

  local chick_dir
  chick_dir="$(resolve_chick_dir "$chick")"

  echo "Hatching harnest ($chick chick) in $(pwd)..."
  echo ""

  # 1. harnest.yaml
  copy_file "$chick_dir/harnest.yaml" "./harnest.yaml" "$force" || true

  # 2. CLAUDE.md
  handle_claudemd "$chick_dir" "$force"

  # 3. Agent definitions
  mkdir -p ".claude/agents"
  for agent in "$chick_dir"/claude/agents/*.md; do
    [ -f "$agent" ] || continue
    local agent_name
    agent_name="$(basename "$agent")"
    copy_file "$agent" ".claude/agents/$agent_name" "$force" || true
  done

  # 4. settings.local.json.example
  if [ -f "$chick_dir/claude/settings.local.json.example" ]; then
    copy_file "$chick_dir/claude/settings.local.json.example" ".claude/settings.local.json.example" "$force" || true
  fi

  # 5. settings.json (deep merge)
  if [ -f "$chick_dir/claude/settings.json" ]; then
    merge_settings "$chick_dir/claude/settings.json" ".claude/settings.json" "$force"
  fi

  # 6. mcp.json.example — copy if present; add .mcp.json to .gitignore
  if [ -f "$chick_dir/claude/mcp.json.example" ]; then
    copy_file "$chick_dir/claude/mcp.json.example" ".mcp.json.example" "$force" || true
    if [ -f ".gitignore" ]; then
      if ! grep -qxF '.mcp.json' .gitignore; then
        echo '.mcp.json' >> .gitignore
        info "added .mcp.json to .gitignore"
      fi
    else
      echo '.mcp.json' > .gitignore
      info "created .gitignore with .mcp.json"
    fi
  fi

  echo ""
  echo "Done! Next steps:"
  echo "  1. Customize harnest.yaml (optional)"
  if [ -f ".mcp.json.example" ]; then
    echo "  2. Set up Nano Banana MCP for AI image generation:"
    echo "     cp .mcp.json.example .mcp.json   # credentials via shell env vars — see .mcp.json.example"
    echo "  3. Run 'claude' to start a harnest session"
  else
    echo "  2. Run 'claude' to start a harnest session"
  fi
}

# ── Flock commands ───────────────────────────────────────────────────────────

# Resolve lib directory (Homebrew or local dev)
if [ -d "$SCRIPT_DIR/../share/harnest/lib" ]; then
  LIB_DIR="$SCRIPT_DIR/../share/harnest/lib"
else
  LIB_DIR="$SCRIPT_DIR/../lib"
fi

flock_usage() {
  cat <<EOF
harnest flock — Chain multiple chicks into a pipeline

Usage:
  harnest flock [run] [--file <path>]     Run a flock pipeline (interactive)
  harnest flock --auto [--file <path>]    Run a flock pipeline autonomously
  harnest flock validate [--file <path>]  Validate a flock.yaml file
  harnest flock init                      Generate a flock.yaml interactively
  harnest flock clean                     Remove temp flock agent files

Options:
  --file <path>   Path to flock.yaml (default: ./flock.yaml)
EOF
}

cmd_flock_validate() {
  local flock_file="flock.yaml"
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)
        if [ $# -lt 2 ]; then echo "Error: --file requires a value"; exit 1; fi
        flock_file="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  local nest_dir="$SHARE_DIR/nest"
  if [ ! -f "$flock_file" ]; then
    echo "Error: $flock_file not found" >&2
    exit 1
  fi
  if [ ! -f "$LIB_DIR/validate-flock.py" ]; then
    echo "Error: validator not found at $LIB_DIR/validate-flock.py" >&2
    echo "Is harnest installed correctly?" >&2
    exit 1
  fi
  python3 "$LIB_DIR/validate-flock.py" "$flock_file" "$nest_dir"
}

cmd_flock_init() {
  local chick="flock"
  local chick_dir
  chick_dir="$(resolve_chick_dir "$chick")"

  echo "Hatching flock meta-chick to help you create a flock.yaml..."
  echo ""

  # Hatch the flock chick into the current project
  cmd_hatch --chick flock "$@"
}

cmd_flock_run() {
  local flock_file="flock.yaml"
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)
        if [ $# -lt 2 ]; then echo "Error: --file requires a value"; exit 1; fi
        flock_file="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  # Step 1: Validate
  echo "Preflight check..."
  echo ""
  if ! cmd_flock_validate --file "$flock_file"; then
    echo ""
    echo "Fix the errors above before running the flock." >&2
    exit 1
  fi
  echo ""

  # Step 2: Read chick references from flock.yaml and hatch agents
  local nest_dir="$SHARE_DIR/nest"
  mkdir -p ".claude/agents"
  mkdir -p ".flock"

  # Extract chick aliases and their nest chick names using the validator's --parse mode
  local chick_map
  chick_map="$(python3 "$LIB_DIR/validate-flock.py" "$flock_file" "$nest_dir" --parse | python3 -c "
import sys, json
data = json.load(sys.stdin)
chicks = data.get('chicks', {})
for alias, cfg in chicks.items():
    if isinstance(cfg, dict) and 'chick' in cfg:
        print(f'{alias}={cfg[\"chick\"]}')
")"

  if [ -z "$chick_map" ]; then
    echo "Error: could not parse chick mappings from $flock_file" >&2
    exit 1
  fi

  echo "Preparing flock agents..."
  echo ""

  # Step 3: Hatch namespaced agents from each referenced chick
  local all_chick_names=""
  while IFS='=' read -r alias chick_name; do
    all_chick_names="$all_chick_names $chick_name"
    local src_dir="$nest_dir/$chick_name"
    if [ ! -d "$src_dir/claude/agents" ]; then
      warn "chick '$chick_name' has no agents directory"
      continue
    fi
    for agent_file in "$src_dir"/claude/agents/*.md; do
      [ -f "$agent_file" ] || continue
      local agent_basename
      agent_basename="$(basename "$agent_file")"
      local namespaced="flock-${alias}-${agent_basename}"
      cp "$agent_file" ".claude/agents/$namespaced"
      info "hatched agent: $namespaced"
    done

    # Merge settings from each chick
    if [ -f "$src_dir/claude/settings.json" ]; then
      merge_settings "$src_dir/claude/settings.json" ".claude/settings.json" "false"
    fi
  done <<< "$chick_map"

  # Step 4: Generate the conductor agent from template
  if [ -f "$LIB_DIR/flock-conductor-template.md" ]; then
    local conductor_file=".claude/agents/flock-conductor.md"
    local flock_contents
    flock_contents="$(cat "$flock_file")"

    # Copy conductor template
    cp "$LIB_DIR/flock-conductor-template.md" "$conductor_file"

    # Append the flock.yaml contents as context
    printf '\n## Flock Configuration (flock.yaml)\n\n```yaml\n%s\n```\n' "$flock_contents" >> "$conductor_file"

    # Append the agent mapping
    printf '%s\n\n' '## Agent Mapping' >> "$conductor_file"
    while IFS='=' read -r alias chick_name; do
      printf -- '- **%s** (%s): ' "$alias" "$chick_name" >> "$conductor_file"
      local src_dir="$nest_dir/$chick_name"
      for agent_file in "$src_dir"/claude/agents/*.md; do
        [ -f "$agent_file" ] || continue
        local agent_basename
        agent_basename="$(basename "$agent_file")"
        printf -- '`flock-%s-%s` ' "$alias" "$agent_basename" >> "$conductor_file"
      done
      printf '\n' >> "$conductor_file"
    done <<< "$chick_map"

    info "generated conductor agent: $conductor_file"
  else
    echo "Error: conductor template not found at $LIB_DIR/flock-conductor-template.md" >&2
    exit 1
  fi

  # Step 5: Copy flock.yaml to project root if not already there
  if [ "$(realpath "$flock_file" 2>/dev/null)" != "$(realpath ./flock.yaml 2>/dev/null)" ]; then
    cp "$flock_file" "./flock.yaml"
    info "copied flock.yaml to project root"
  fi

  echo ""
  echo "Flock is ready! Next steps:"
  echo "  1. Run 'claude' to start the flock session"
  echo "  2. The flock conductor will orchestrate the pipeline automatically"
  echo ""
}

cmd_flock_auto() {
  local flock_file="flock.yaml"
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)
        if [ $# -lt 2 ]; then echo "Error: --file requires a value"; exit 1; fi
        flock_file="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  # Step 1: Validate
  echo "Preflight check..."
  echo ""
  if ! cmd_flock_validate --file "$flock_file"; then
    echo ""
    echo "Fix the errors above before running the flock." >&2
    exit 1
  fi
  echo ""

  local nest_dir="$SHARE_DIR/nest"

  # Step 2: Pre-flight interview — ask clarifying questions before autonomous execution
  echo "┌─────────────────────────────────────────────────────────────┐"
  echo "│  AUTONOMOUS MODE — Pre-flight Interview                     │"
  echo "│                                                             │"
  echo "│  Agents will run with elevated permissions.                 │"
  echo "│  Please answer the following questions carefully.           │"
  echo "└─────────────────────────────────────────────────────────────┘"
  echo ""

  # Extract and display execution plan for user review
  python3 "$LIB_DIR/validate-flock.py" "$flock_file" "$nest_dir" --parse | python3 -c "
import sys, json

data = json.load(sys.stdin)
chicks = data.get('chicks', {})
settings = data.get('settings', {})
timeout = settings.get('timeout', 30) if isinstance(settings, dict) else 30

print('Execution plan:')
print()
for i, (alias, cfg) in enumerate(chicks.items(), 1):
    if not isinstance(cfg, dict):
        continue
    chick = cfg.get('chick', '?')
    prompt = cfg.get('prompt', cfg.get('prompt_file', '(none)'))
    deps = cfg.get('depends_on', '(none)')
    t = cfg.get('timeout', timeout)
    print(f'  {i}. [{alias}] ({chick})')
    p = str(prompt)
    print(f'     Prompt: {p[:80]}...' if len(p) > 80 else f'     Prompt: {p}')
    print(f'     Depends on: {deps}')
    print(f'     Timeout: {t} min')
    print()

print(f'Global continue_on_failure: {settings.get(\"continue_on_failure\", False)}')
print(f'Global timeout: {timeout} min')
"
  echo ""

  # Ask for confirmation
  printf "Do you approve this execution plan? [y/N] "
  read -r confirm
  if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "Aborted."
    exit 0
  fi
  echo ""

  # Step 3: Set up the flock (reuse cmd_flock_run setup)
  cmd_flock_run --file "$flock_file"

  echo ""
  echo "Auto mode setup complete."
  echo "To run autonomously, launch claude with the conductor agent:"
  echo "  claude --agent-file .claude/agents/flock-conductor.md --dangerously-skip-permissions"
  echo ""
  echo "Logs will be written to .flock/logs/"
  mkdir -p ".flock/logs"
}

cmd_flock_clean() {
  echo "Cleaning up flock temp files..."
  echo ""

  # Remove namespaced flock agent files
  local count=0
  for f in .claude/agents/flock-*.md; do
    [ -f "$f" ] || continue
    rm "$f"
    info "removed $f"
    count=$((count + 1))
  done

  # Remove .flock/ working directory
  if [ -d ".flock" ]; then
    rm -rf ".flock"
    info "removed .flock/"
    count=$((count + 1))
  fi

  if [ "$count" -eq 0 ]; then
    echo "  Nothing to clean up."
  fi
  echo ""
  echo "Done. flock.yaml and chick outputs (e.g., brainstorm-output.md) are preserved."
}

cmd_flock() {
  case "${1:-run}" in
    run)       shift; cmd_flock_run "$@" ;;
    --auto)    shift; cmd_flock_auto "$@" ;;
    validate)  shift; cmd_flock_validate "$@" ;;
    init)      shift; cmd_flock_init "$@" ;;
    clean)     shift; cmd_flock_clean "$@" ;;
    help|--help|-h) flock_usage ;;
    *)         echo "Unknown flock command: $1"; flock_usage; exit 1 ;;
  esac
}

# ── Main ─────────────────────────────────────────────────────────────────────

case "${1:-help}" in
  hatch)      shift; cmd_hatch "$@" ;;
  nest)       cmd_nest ;;
  flock)      shift; cmd_flock "$@" ;;
  --chick)
    if [ $# -lt 2 ]; then
      echo "Error: --chick requires a value"
      exit 1
    fi
    set_default_chick "$2" ;;
  version|--version|-v)  echo "harnest $VERSION" ;;
  help|--help|-h)        usage ;;
  *)          echo "Unknown command: $1"; usage; exit 1 ;;
esac
