{
  "_comment": "Local overrides — copy this to settings.local.json and customize. This file is gitignored. DO NOT store API keys or credentials here — pass them as shell env vars instead.",
  "mcpServers": {
    "nanobanana": {
      "disabled": false,
      "_comment": [
        "Nano Banana MCP for AI image generation. Credentials are NOT stored here.",
        "",
        "Option A — Vertex AI (recommended, uses a service account credential file):",
        "  export NANOBANANA_AUTH_METHOD=vertex_ai",
        "  export GCP_PROJECT_ID=your-gcp-project-id",
        "  export GCP_REGION=us-central1",
        "  export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json",
        "",
        "Option B — Gemini API key (simpler, but a direct secret):",
        "  export NANOBANANA_AUTH_METHOD=api_key",
        "  export GEMINI_API_KEY=your-key-here",
        "",
        "Then run: harnest fly \"build a website for ...\""
      ]
    },
    "playwright": {
      "disabled": false
    }
  }
}
